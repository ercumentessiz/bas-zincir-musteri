rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Bu listeyi firestore.rules'daki allowedEmails() ile AYNI tutun.
      allow read: if request.auth != null && request.auth.token.email in [
        "pdrercumentessiz@gmail.com",
        "baszincirosb@gmail.com",
        "baszincir@gmail.com",
        "pazarlama2@baszincir.com.tr"
      ];
      allow write: if request.auth != null &&
        request.auth.token.email == "pdrercumentessiz@gmail.com" &&
        request.resource.size < 10 * 1024 * 1024;
    }
  }
}
